/* Beta 1.205 — desktop crosshair compositor, owned by one hover controller. */
#dvlCrosshairDom1205{
  position:absolute!important; inset:0!important; z-index:13!important;
  pointer-events:none!important; overflow:hidden!important; contain:strict!important;
  display:none;
}
html.dvl-desktop-pro-1179 #dvlCrosshairDom1205{display:block;}
#dvlCrosshairDom1205 .dvl-x-v,
#dvlCrosshairDom1205 .dvl-x-h,
#dvlCrosshairDom1205 .dvl-x-dot,
#dvlCrosshairDom1205 .dvl-x-price,
#dvlCrosshairDom1205 .dvl-x-time{
  position:absolute; left:0; top:0; will-change:transform; backface-visibility:hidden;
}
#dvlCrosshairDom1205 .dvl-x-v{
  width:1px; height:100%; border-left:1px dashed rgba(16,223,119,.52);
  transform:translate3d(-9999px,0,0);
}
#dvlCrosshairDom1205 .dvl-x-h{
  width:100%; height:1px; border-top:1px dashed rgba(16,223,119,.52);
  transform:translate3d(0,-9999px,0);
}
#dvlCrosshairDom1205 .dvl-x-dot{
  width:6px; height:6px; margin:-3px 0 0 -3px; border-radius:50%;
  background:rgba(16,223,119,.94); box-shadow:0 0 5px rgba(16,223,119,.28);
  transform:translate3d(-9999px,-9999px,0);
}
#dvlCrosshairDom1205 .dvl-x-price{
  width:75px; min-width:54px; max-width:75px; height:22px; padding:0 5px; border-radius:5px;
  display:flex; align-items:center; justify-content:center; box-sizing:border-box; overflow:hidden;
  background:#10df77; color:#020806; font:900 9px/1 system-ui;
  white-space:nowrap; text-overflow:clip; transform:translate3d(-9999px,-9999px,0);
}
#dvlCrosshairDom1205 .dvl-x-time{
  height:18px; padding:0 7px; border-radius:6px;
  display:flex; align-items:center; justify-content:center;
  border:1px solid rgba(16,223,119,.42); background:rgba(4,12,8,.96);
  color:#f4f6f4; font:850 9px/1 system-ui; white-space:nowrap;
  transform:translate3d(-9999px,-9999px,0);
}
#dvlCrosshairDom1205.dvl-hidden{visibility:hidden;}

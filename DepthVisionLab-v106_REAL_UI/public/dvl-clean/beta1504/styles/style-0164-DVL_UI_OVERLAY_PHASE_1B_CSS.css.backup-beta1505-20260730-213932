:root{
  --bg0:#020806;
  --bg1:#030d0a;
  --bg2:#010504;
  --card:rgba(5,14,12,.92);
  --card2:rgba(7,17,15,.94);
  --panel:rgba(5,14,12,.92);
  --panel-soft:rgba(4,12,10,.68);
  --line:rgba(110,140,130,.16);
  --lineSoft:rgba(145,175,165,.10);
  --grid:rgba(122,155,145,.092);
  --gridSoft:rgba(122,155,145,.055);
  --text:#f4f6f4;
  --muted:#a5aaa9;
  --muted2:#737b79;
  --accent:#10df77;
  --green:#10df77;
  --cyan:#10df77;
  --cyan2:rgba(16,223,119,.76);
  --accentLine:rgba(16,223,119,.76);
  --red:#ff3037;
  --yellow:#ffd321;
  --orange:#ff9900;
  --shadow:0 18px 50px rgba(0,0,0,.40);
}

/* Trade drawer: navy -> green-black */
.tradeDrawerSheet{
  background:linear-gradient(180deg,rgba(5,14,12,.97),rgba(3,10,8,.99)) !important;
  border-color:rgba(16,223,119,.18) !important;
}
.tradeDrawerHandle{border-bottom-color:rgba(110,140,130,.16) !important}

/* Trade pull glyph: cyan -> green */
.tradePullGlyph{color:#10df77 !important}

/* Generic dark panels / modals with navy remnants */
.numPad,.numPadWrap,[id*="numPad"],[class*="numPad"]{
  background:rgba(5,14,12,.96) !important;
  border-color:rgba(110,140,130,.16) !important;
}
.numKey,[class*="numKey"]{
  background:rgba(7,17,15,.80) !important;
  border-color:rgba(110,140,130,.14) !important;
  color:var(--text) !important;
}

/* Order type / confirm panels */
[class*="orderType"],[class*="confirmBox"],[class*="pendingBox"]{
  background:rgba(5,14,12,.96) !important;
  border-color:rgba(110,140,130,.16) !important;
}

/* Toast / snackbar */
.toast,.toastMsg,[class*="toast"]{
  background:rgba(5,14,12,.96) !important;
  border-color:rgba(16,223,119,.22) !important;
}

/* Chart settings panel */
[class*="chartSettings"],[id*="chartSettings"]{
  background:rgba(5,14,12,.96) !important;
  border-color:rgba(110,140,130,.16) !important;
}

/* Bottom nav inactive items: muted green-grey */
.navItem{color:#6b7d70 !important}

/* Bottom nav svg icons inherit currentColor (no forced blue) */
.navItem svg{stroke:currentColor !important}

/* Bottom nav label text */
.navItem span,.navItem .navLabel{color:inherit !important}

/* reset button: static CSS — fills pill height as a square */
.dvlDemoReset{background:none!important;border:none!important;color:var(--orange)!important;opacity:.60!important;cursor:pointer!important;font-size:16px!important;line-height:1!important;padding:0!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;align-self:stretch!important;aspect-ratio:1/1!important;margin-left:4px!important;}
.dvlDemoReset:hover,.dvlDemoReset:active{opacity:1!important;}

/* asset dropdown: escape hidden .marketRow via same overflow trick */
html.dvl-ui-1b-active .marketRow:has(#assetDropdown.is-open){display:block!important;visibility:hidden!important;position:fixed!important;left:0!important;top:0!important;width:0!important;height:0!important;min-height:0!important;padding:0!important;margin:0!important;border:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;pointer-events:none!important;z-index:99998!important;}
html.dvl-ui-1b-active #assetDropdown.is-open{pointer-events:auto!important;}

/* settings via new header: expose toolbar overflow so panel can escape display:none */
html.dvl-ui-1b-active .chartCard>.toolbar:has(#chartSettingsPanel.is-open){display:block!important;visibility:hidden!important;position:fixed!important;left:0!important;top:0!important;width:0!important;height:0!important;min-height:0!important;padding:0!important;margin:0!important;border:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;pointer-events:none!important;z-index:100000!important;}
html.dvl-ui-1b-active #chartSettingsPanel.is-open{position:fixed!important;right:10px!important;bottom:70px!important;top:auto!important;left:auto!important;pointer-events:auto!important;}
/* 0.782 — Symbol button fills available space (flex:1 1 auto already handles this; no max-width cap) */
#DVL_UI_OVERLAY_PHASE_1B #dvl1b_symbolBtn{ max-width:none; }
/* 0.782 — Gear moved to row1 */
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-row1-gear{ width:calc(52 * var(--px)); height:calc(56 * var(--px)); flex:0 0 auto; border-color:transparent!important; background:transparent!important; padding:0; }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-row1-gear svg{ width:calc(28 * var(--px)); height:calc(28 * var(--px)); }
/* 0.782 — TF picker wider to show 4 favorites */
#DVL_UI_OVERLAY_PHASE_1B #dvl1b_tfPicker{ flex:0 1 calc(250 * var(--px)); min-width:calc(80 * var(--px)); max-width:calc(250 * var(--px)); }
/* 0.783 — TF dropdown trigger button + wrapper */
#DVL_UI_OVERLAY_PHASE_1B #dvl1b_tfDropWrap{ touch-action:manipulation; }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropBtn{ font-weight:700; touch-action:manipulation; cursor:pointer; -webkit-tap-highlight-color:rgba(16,223,119,.18); }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropBtn.dvl1b-open{ color:#10df77; }
/* 0.782 — TF dropdown menu items */
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropMenu{ min-width:calc(150 * var(--px)); max-height:calc(380 * var(--px)); overflow-y:auto; scrollbar-width:none; z-index:999999!important; position:absolute!important; top:calc(100% + 6px)!important; left:0!important; }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropMenu::-webkit-scrollbar{ display:none; }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropItem{ display:flex; align-items:center; gap:calc(10 * var(--px)); width:100%; height:calc(44 * var(--px)); padding:0 calc(12 * var(--px)); border-radius:calc(8 * var(--px)); font-size:calc(19 * var(--px)); font-weight:500; color:#e7ecea; white-space:nowrap; cursor:pointer; border:0; background:transparent; text-align:left; }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropItem:active{ background:rgba(16,223,119,.12); }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropItem.is-active .dvl1b-tfDropLabel{ color:#10df77; font-weight:700; }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropLabel{ flex:1; }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropStar{ flex:0 0 auto; padding:calc(4 * var(--px)); opacity:.4; transition:opacity .15s; display:flex; align-items:center; justify-content:center; }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropStar.is-fav{ opacity:1; }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropStar svg{ width:calc(18 * var(--px)); height:calc(18 * var(--px)); display:block; }
#DVL_UI_OVERLAY_PHASE_1B .dvl1b-tfDropGroup{ font-size:calc(11 * var(--px)); font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:rgba(150,180,165,.45); padding:calc(10 * var(--px)) calc(14 * var(--px)) calc(3 * var(--px)); pointer-events:none; }

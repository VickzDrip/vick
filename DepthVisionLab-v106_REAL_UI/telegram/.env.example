# DVL Telegram Alerts V1 — variáveis de ambiente (defina SÓ no servidor).
# Nunca comitar valores reais. No servidor use pm2 --update-env + pm2 save,
# ou um arquivo carregado só no processo do backend.

# Token do bot oficial (@BotFather). Sem isto a feature fica 100% desligada.
TELEGRAM_BOT_TOKEN=

# Segredo aleatório do webhook (ex.: `openssl rand -hex 32`). Precisa ser o
# MESMO usado no set-webhook.js e validado no header X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Username do bot (sem @). Usado no deep-link t.me/<username>?start=<token>.
TELEGRAM_BOT_USERNAME=DvlalertsBot

# URL pública do DVL (base do webhook e dos links "Abrir no DVL").
DVL_PUBLIC_URL=https://depthvisionlab.com

# Opcional — "0" força desligar mesmo com token presente (kill switch).
# TELEGRAM_ENABLED=1

# Opcional — modo informativo p/ a UI: "server" (24/7) ou "client" (só com DVL aberto).
# DVL_ALERTS_MODE=server

# Opcional — segredo p/ assinar o cookie de identidade de dispositivo.
# Se ausente, é gerado e salvo em data/device-secret.key.
# DVL_DEVICE_SECRET=

# Opcional — caminho do banco SQLite (padrão: data/dvl-telegram.db).
# DVL_TELEGRAM_DB=
